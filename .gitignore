# ==============================================================================
# TradePilot — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, API Keys & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.key
*.pem
*.cert
*.crt
secrets/
credentials/
config/secrets.*

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Python Binaries
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
Scripts/

# ------------------------------------------------------------------------------
# 3. MLOps & Experiment Tracking (DVC & MLflow)
# ------------------------------------------------------------------------------
# MLflow SQLite database & journal/write-ahead logs
mlflow.db
mlflow.db*
*.db
*.db-*
*.sqlite
*.sqlite3

# MLflow artifact stores
mlruns/
mlartifacts/
.trash/

# DVC local storage remote and internal caches
.dvc_storage/
.dvc/cache/
.dvc/tmp/
.dvc/plots/

# Data & Model binary backups (managed via DVC pointers: *.dvc & dvc.lock)
data/raw/*.csv
!data/raw/.gitignore
data/processed/*.csv
!data/processed/.gitignore
models/*.joblib
!models/.gitignore
*.joblib
*.pkl
*.pickle
*.parquet
*.h5

# ------------------------------------------------------------------------------
# 4. Python Bytecode & Runtime Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyo

# ------------------------------------------------------------------------------
# 5. Packaging, Builds & Distributions
# ------------------------------------------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 6. Testing, Code Coverage & Linting Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 7. Jupyter & Interactive Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 8. IDEs, Editors & AI Agent Workspaces
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
.agents/
.gemini/
scratch/

# ------------------------------------------------------------------------------
# 9. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
[Dd]esktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
*.stackdump

# ------------------------------------------------------------------------------
# 10. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 11. Terraform & Local Containers
# ------------------------------------------------------------------------------
deploy/terraform/.terraform/
deploy/terraform/.terraform.lock.hcl
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfplan
pgdata/

